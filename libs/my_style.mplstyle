#
# Matplotlib Style Sheet (Monochrome + Paul Tol's Muted)
#

### FONT PROPERTIES ###
font.family         : sans-serif
font.sans-serif     : Arial
font.size           : 20.0

# テキスト全般の色（チャコールブラック）
text.color          : 212529

### AXES PROPERTIES ###
axes.titlesize      : 20.0
axes.titlecolor     : 212529
axes.labelsize      : 20.0
axes.labelcolor     : 212529

# グラフエリアの背景と枠線の設定（オフホワイト）
axes.facecolor      : F8F9FA
axes.edgecolor      : DEE2E6
axes.linewidth      : 0.8

### TICKS PROPERTIES ###
# 目盛りとラベルの色
xtick.color         : 212529
xtick.labelsize     : 20.0
ytick.color         : 212529
ytick.labelsize     : 20.0
xtick.major.size   : 8
xtick.major.width  : 1.5
ytick.major.size   : 8
ytick.major.width  : 1.5
xtick.direction    : out
ytick.direction    : out

### LEGEND PROPERTIES ###
legend.fontsize     : 18.0
legend.frameon      : True  # 背景に馴染ませるため枠線なしを推奨

### COLOR CYCLE (Paul Tol's Muted) ###
# 各色に # を追加し、引用符を削除しました
axes.prop_cycle : cycler('color', ['CC6677', '332288', 'DDCC77', '117733', '88CCEE', '882255', '44AA99', '999933', 'AA4499'])

### LINE & MARKER PROPERTIES ###
lines.linewidth     : 3.0
lines.markersize    : 10.0
# lines.color はカラーサイクルが優先されるため、基本は指定しなくてOKです

### GRID PROPERTIES ###
# グリッドの色を薄いグレーに設定
axes.grid           : True
grid.color          : DEE2E6
grid.alpha          : 0.8
grid.linestyle      : --
axes.axisbelow     : True # gridをデータの下に描く

### FIGURE PROPERTIES ###
# 図全体の背景色（オフホワイト）
figure.facecolor    : F8F9FA
figure.edgecolor    : F8F9FA
figure.dpi          : 300
figure.autolayout   : True
figure.figsize      : 8, 6

### SAVEFIG PROPERTIES ###
savefig.format      : png
savefig.dpi         : 300
savefig.bbox        : tight
savefig.facecolor   : F8F9FA